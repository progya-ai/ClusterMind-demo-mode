# Copy to .env (docker compose reads it automatically).
# Reuse models you already downloaded elsewhere instead of downloading 7 GB again:
# CM_MODELS_HOST=../clustermind-docker/models
# Web GUI port on your Mac (always bound to 127.0.0.1):
# CM_WEB_PORT=8000
# Optional access token for the web GUI (open http://localhost:8000/?token=...):
# CM_WEB_TOKEN=
# CPU threads for llama.cpp (0 = all CPUs given to Docker):
# CM_THREADS=0
